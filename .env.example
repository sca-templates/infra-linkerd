# =============================================================================
# linkerd — Environment Variables
# =============================================================================
# Local: optional. Copy to `.env` (gitignored) to override defaults; `make`
# targets read it via `-include .env`. Production: versions and values are
# declared in infra-kubernetes envs/<env> and applied by ArgoCD.
# =============================================================================

# ── Project ─────────────────────────────────────────────────────────────────
ENVIRONMENT=dev

# ── Linkerd ─────────────────────────────────────────────────────────────────
# `stable` channel tag installed by scripts/install.sh (linkerd install).
LINKERD_VERSION=stable-2.16
LINKERD_NAMESPACE=linkerd

# Optional: path to a kubeconfig for a non-default cluster.
KUBECONFIG=
